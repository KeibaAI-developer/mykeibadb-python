# 環境変数サンプルファイル
# このファイルを .env にコピーして使用してください

# ========================================
# PostgreSQL接続設定
# ========================================
# ローカル接続（デフォルト）
# SSMポートフォワーディング不要。ローカルのPostgreSQLに直接接続する。
# Dockerコンテナ内からはhost.docker.internalでホストに接続する。
# MYKEIBADB_HOST=host.docker.internal
# MYKEIBADB_PORT=5432
# MYKEIBADB_DATABASE=mykeibadb
# MYKEIBADB_USER=postgres
# MYKEIBADB_PASSWORD=postgres

# クラウド（AWS EC2）接続
# 事前にSSMポートフォワーディング（15432）を起動しておくこと。
MYKEIBADB_HOST=host.docker.internal
MYKEIBADB_PORT=15432
MYKEIBADB_DATABASE=mykeibadb
MYKEIBADB_USER=mykeibadb
MYKEIBADB_PASSWORD=<EC2パスワード>